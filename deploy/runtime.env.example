# Copy to deploy/runtime.env, then replace only paths if this checkout moves.
# This file is shell syntax. Keep every value quoted. Do not add secrets here.

VIDEO_UPSCALE_PROJECT_ROOT="/Users/yourname/dev/video-upscale-webui"
VIDEO_UPSCALE_RUNTIME_ROOT="/Users/yourname/Library/Application Support/VideoUpscaleWebUI/runtime"
VIDEO_UPSCALE_DATA_ROOT="/Users/yourname/Library/Application Support/VideoUpscaleWebUI/data"

# Isolated ComfyUI / SeedVR2 installation. Never put this inside Git checkout.
VIDEO_UPSCALE_COMFY_DIR="/Users/yourname/Library/Application Support/VideoUpscaleWebUI/runtime/ComfyUI"
VIDEO_UPSCALE_SEEDVR2_DIR="/Users/yourname/Library/Application Support/VideoUpscaleWebUI/runtime/ComfyUI/custom_nodes/ComfyUI-SeedVR2_VideoUpscaler"
# Backend uses this adapter. It maps stable app profiles to official SeedVR2 CLI argv.
VIDEO_UPSCALE_SEEDVR2_CLI="/Users/yourname/dev/video-upscale-webui/scripts/seedvr2-adapter.py"
VIDEO_UPSCALE_SEEDVR2_OFFICIAL_CLI="/Users/yourname/Library/Application Support/VideoUpscaleWebUI/runtime/ComfyUI/custom_nodes/ComfyUI-SeedVR2_VideoUpscaler/inference_cli.py"
VIDEO_UPSCALE_SEEDVR2_MODEL_DIR="/Users/yourname/Library/Application Support/VideoUpscaleWebUI/runtime/models/SEEDVR2"
VIDEO_UPSCALE_PYTHON="/Users/yourname/Library/Application Support/VideoUpscaleWebUI/runtime/ComfyUI/.venv/bin/python"
VIDEO_UPSCALE_FFMPEG="/opt/homebrew/bin/ffmpeg"
VIDEO_UPSCALE_FFPROBE="/opt/homebrew/bin/ffprobe"

# Backend agent owns this isolated environment.
VIDEO_UPSCALE_BACKEND_PYTHON="/Users/yourname/dev/video-upscale-webui/backend/.venv/bin/python"
VIDEO_UPSCALE_BACKEND_MODULE="app.main:app"
VIDEO_UPSCALE_APP_PORT="8000"
VIDEO_UPSCALE_COMFY_PORT="8188"
VIDEO_UPSCALE_TAILSCALE_HTTPS_PORT="8444"
VIDEO_UPSCALE_TAILSCALE_USER_LOGIN="haohan.apple@outlook.com"
VIDEO_UPSCALE_DISK_RESERVE_GB="20"

# Admission and resource safety limits. Raise intentionally for a trusted operator.
VIDEO_UPSCALE_PYTHON_VERSION="3.13.11"
VIDEO_UPSCALE_FFPROBE_TIMEOUT_SECONDS="30"
VIDEO_UPSCALE_UPLOAD_IDLE_TIMEOUT_SECONDS="30"
VIDEO_UPSCALE_UPLOAD_TOTAL_TIMEOUT_SECONDS="21600"
VIDEO_UPSCALE_MAX_DURATION_SECONDS="3600"
VIDEO_UPSCALE_MAX_SOURCE_DIMENSION="3840"
VIDEO_UPSCALE_MAX_SOURCE_PIXELS="8294400"
VIDEO_UPSCALE_MAX_SOURCE_FRAME_RATE="120"
VIDEO_UPSCALE_MAX_SOURCE_FRAMES="216000"
VIDEO_UPSCALE_MAX_PENDING_JOBS="3"
VIDEO_UPSCALE_MAX_PROCESS_SECONDS="86400"
VIDEO_UPSCALE_MAX_JOB_LOG_BYTES="10485760"
VIDEO_UPSCALE_MAX_JOB_ARTIFACT_BYTES="68719476736"

# Keep MPS allocator below Apple unified-memory exhaustion. SeedVR2 upstream
# defaults disable these allocator limits; do not set either value to 0.0.
PYTORCH_MPS_HIGH_WATERMARK_RATIO="0.75"
PYTORCH_MPS_LOW_WATERMARK_RATIO="0.60"

# Production default: small, bounded 3B profile. Backend maps these profile IDs
# to explicit SeedVR2 argv; it must never enable swap / overflow fallback.
VIDEO_UPSCALE_DEFAULT_PROFILE="3b-safe"
VIDEO_UPSCALE_DEFAULT_OUTPUT_SCALE="1"
VIDEO_UPSCALE_DEVICE_BACKEND_CLASS="apple-mps"
VIDEO_UPSCALE_HEARTBEAT_STALE_SECONDS="120"
VIDEO_UPSCALE_PROGRESS_STALE_SECONDS="300"
VIDEO_UPSCALE_SEEDVR2_3B_MODEL="seedvr2_ema_3b_fp8_e4m3fn.safetensors"
VIDEO_UPSCALE_SEEDVR2_7B_FP8_MODEL="seedvr2_ema_7b_fp8_e4m3fn_mixed_block35_fp16.safetensors"

# SeedVR2 is an external, pinned fork runtime. Update it only through a reviewed
# `scripts/install-runtime.sh --apply --update` after every queued or active job
# reaches a terminal state.
