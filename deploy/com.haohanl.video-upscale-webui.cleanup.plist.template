<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.haohanl.video-upscale-webui.cleanup</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>__PROJECT_ROOT__/scripts/cleanup-data.sh</string>
    <string>--apply</string>
    <string>--older-than-hours</string>
    <string>24</string>
  </array>
  <key>StartInterval</key>
  <integer>3600</integer>
  <key>ProcessType</key>
  <string>Background</string>
  <key>StandardOutPath</key>
  <string>__DATA_ROOT__/logs/cleanup.stdout.log</string>
  <key>StandardErrorPath</key>
  <string>__DATA_ROOT__/logs/cleanup.stderr.log</string>
</dict>
</plist>
